# Copy to an untracked runtime.env and inject secret values from the secret store.
# This file is a placeholder contract; do not use it as a production secret file.
RUNTIME_ENVIRONMENT=production
RUNTIME_API_HOST=127.0.0.1
RUNTIME_API_PORT=8000
RUNTIME_API_BASE_PATH=/api/v1/runtime
RUNTIME_DEEPAGENTS_SDK_VERSION=0.7.7
RUNTIME_ALLOW_DEV_AUTH=0
RUNTIME_ENABLE_PRODUCTION_COMPOSITION=1
# Deployment-owned async factory returning Principal | None for a Bearer token.
# The runtime intentionally has no permissive production auth fallback.
RUNTIME_PRINCIPAL_VERIFIER_FACTORY=<module:attribute>

# Runtime data services
RUNTIME_DATABASE_URL=postgresql+asyncpg://runtime:${RUNTIME_DATABASE_PASSWORD}@127.0.0.1:5432/runtime
RUNTIME_DATABASE_PASSWORD=<inject-from-secret-store>
RUNTIME_REDIS_URL=redis://127.0.0.1:6379/0
RUNTIME_MINIO_ENDPOINT=127.0.0.1:9000
RUNTIME_MINIO_ACCESS_KEY=<inject-from-secret-store>
RUNTIME_MINIO_SECRET_KEY=<inject-from-secret-store>
RUNTIME_MINIO_SECURE=0
RUNTIME_MINIO_BUCKET=runtime-payloads
# compose.integration.yml maps the two values above to MinIO's root user and
# password. Provision this bucket before accepting traffic; /health/ready
# remains 503 until the bucket probe succeeds.

# Server-side model and Tool Gateway credentials. Never expose these to the console.
# These names are consumed by packages/model_gateway/client.py.
MODEL_GATEWAY_BASE_URL=https://model-gateway.internal/v1
MODEL_GATEWAY_API_KEY=<inject-from-secret-store>
MODEL_GATEWAY_MODEL=<configured-model-alias>
RUNTIME_TOOL_GATEWAY_URL=https://tool-gateway.internal
RUNTIME_TOOL_GATEWAY_API_KEY=<inject-from-secret-store>

# Process and observability settings
RUNTIME_WORKER_ID=<stable-worker-identity>
RUNTIME_DEFAULT_TENANT_ID=<runtime-tenant>
RUNTIME_DEFAULT_AGENT_ID=agent-metric-query
RUNTIME_DEFAULT_AGENT_VERSION=0.1.0
RUNTIME_DEFAULT_PACKAGE_DIGEST=sha256:<verified-package-digest>
RUNTIME_PACKAGES_ROOT=agents
RUNTIME_WORKER_ENTRYPOINT=apps.runtime_worker.consumer:TaskConsumer
RUNTIME_PROMETHEUS_URL=http://127.0.0.1:9090
RUNTIME_GRAFANA_URL=http://127.0.0.1:3000

# Explicit opt-in only. Leave disabled when live services are unavailable.
RUNTIME_TASK14_LIVE=0
RUNTIME_TASK14_LIVE_BASE_URL=
RUNTIME_TASK14_LIVE_TOKEN=<inject-from-secret-store>
