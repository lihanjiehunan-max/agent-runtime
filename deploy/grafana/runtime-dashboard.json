{
  "title": "Enterprise Agent Runtime",
  "uid": "enterprise-agent-runtime",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Executions by status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(runtime_executions_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Execution p95 duration",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(runtime_execution_duration_seconds_bucket[5m])) by (le, status))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Model and tool duration",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(runtime_model_duration_seconds_sum[5m])",
          "legendFormat": "model"
        },
        {
          "expr": "rate(runtime_tool_duration_seconds_sum[5m])",
          "legendFormat": "tool"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Token totals",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(runtime_tokens_total[5m])) by (direction)",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active sessions and queue depth",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "runtime_active_sessions",
          "legendFormat": "active sessions"
        },
        {
          "expr": "runtime_queue_depth",
          "legendFormat": "queue depth"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Package cache hit ratio",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(runtime_package_cache_events_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(runtime_package_cache_events_total[5m])), 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cancellation latency p95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(runtime_cancellation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
