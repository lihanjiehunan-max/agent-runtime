[Unit]
Description=Enterprise Agent Runtime API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-runtime
Group=agent-runtime
WorkingDirectory=/opt/agent-runtime
EnvironmentFile=/etc/agent-runtime/runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=RUNTIME_API_BASE_PATH=/api/v1/runtime
Environment=RUNTIME_DEEPAGENTS_SDK_VERSION=0.7.7
Environment=RUNTIME_ENABLE_PRODUCTION_COMPOSITION=1
ExecStart=/opt/agent-runtime/.venv/bin/uvicorn apps.runtime_api.main:app --host ${RUNTIME_API_HOST} --port ${RUNTIME_API_PORT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-runtime

[Install]
WantedBy=multi-user.target
